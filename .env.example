# Copy to .env and adjust if needed. Never commit the real .env file.
# Used by docker-compose.yml and by src/bcm_planner/db.py (via os.environ).

POSTGRES_USER=bcm_admin
POSTGRES_PASSWORD=bcm_local_dev_password
POSTGRES_DB=bcm_continuity_planner
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: full DSN override. If set, takes precedence over the discrete
# POSTGRES_* variables above (see src/bcm_planner/db.py).
# DATABASE_URL=postgresql://bcm_admin:bcm_local_dev_password@localhost:5432/bcm_continuity_planner
