# Copy to .env and adjust if needed. Never commit the real .env file.
# Used by docker-compose.yml and by src/bcm_planner/db.py (via os.environ).

POSTGRES_USER=bcm_admin
POSTGRES_PASSWORD=bcm_local_dev_password
POSTGRES_DB=bcm_continuity_planner
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: full DSN override. If set, takes precedence over the discrete
# POSTGRES_* variables above (see src/bcm_planner/db.py).
# DATABASE_URL=postgresql://bcm_admin:bcm_local_dev_password@localhost:5432/bcm_continuity_planner

# --- Web workshop tool (src/bcm_planner/web/) --------------------------
# Only used when running `bcm-web` / `uvicorn bcm_planner.web.app:app`
# (see docs/web_workshop_tool.md). Not used by the MCP server.

# Port the web app listens on. Render sets this automatically at deploy
# time (see render.yaml) — only needed locally if you want a non-default port.
PORT=8000

# No SECRET_KEY / session-signing is currently used — workshop access
# control is via the unguessable per-organization session_token in the URL
# path (web_workshop_sessions.session_token, schema/004), not a signed
# cookie session. Documented here as a placeholder in case cookie-based
# session signing is added in a future iteration.
# SECRET_KEY=changeme
